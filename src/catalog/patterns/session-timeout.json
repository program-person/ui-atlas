{
  "id": "session-timeout",
  "nameJa": "セッション期限の警告",
  "nameEn": "Session Timeout",
  "aliases": [
    "セッション期限の警告",
    "session-timeout"
  ],
  "tags": [
    "操作",
    "状態",
    "確認"
  ],
  "category": "UXの流れ",
  "summary": "期限前に警告し、継続または終了を選ぶ。",
  "description": "利用期限が近づくと残り時間を示し、延長または終了を選べる。通常の進捗表示とは異なり、時間切れ後に操作が変わる。",
  "useCases": [
    "有効期限のある作業画面",
    "一定時間で終了するデモ"
  ],
  "cautions": [
    "実際のセッション制限には必要に応じて十分な警告と延長手段を設ける。",
    "時間切れによる未保存内容の扱いを明示する。"
  ],
  "relatedIds": [
    "alert-banner",
    "progress-bar"
  ],
  "demoId": "session-timeout",
  "controls": [
    {
      "id": "mode",
      "label": "期限",
      "help": "期限を切り替えます。",
      "default": "short",
      "options": [
        {
          "value": "short",
          "label": "短い",
          "promptValue": "8秒の期限"
        },
        {
          "value": "long",
          "label": "長い",
          "promptValue": "12秒の期限"
        }
      ]
    },
    {
      "id": "warning",
      "label": "警告",
      "help": "警告を切り替えます。",
      "default": "early",
      "options": [
        {
          "value": "early",
          "label": "早め",
          "promptValue": "残り5秒から警告"
        },
        {
          "value": "late",
          "label": "直前",
          "promptValue": "残り2秒から警告"
        }
      ]
    }
  ],
  "prompt": "{{mode}}とし、{{warning}}してください。期限前に延長でき、終了または時間切れを表示してください。",
  "references": [
    {
      "title": "公式資料",
