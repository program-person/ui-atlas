{
  "id": "selection-limit",
  "nameJa": "選択数の上限",
  "nameEn": "Selection Limit",
  "aliases": [
    "選択数の上限",
    "selection-limit"
  ],
  "tags": [
    "操作",
    "状態",
    "確認"
